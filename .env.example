# Database
DATABASE_URL=postgresql+asyncpg://baize:password@localhost:5432/baize

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
ADMIN_API_KEY=your-admin-api-key-here
SECRET_KEY=your-secret-key-here

# Observability
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
LANGFUSE_HOST=http://langfuse:3000
LOG_LEVEL=INFO

# LLM Providers
DOUBAO_API_KEY=your-doubao-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
NEWAPI_KEY=your-newapi-api-key-here

# App
DEBUG=false

# Memory (see config/config.example.yaml for full memory.mem0 config)
# Memory behaviour toggles are set in config.yaml, not .env:
#   memory.auto_recall: true      # auto-inject recalled memories before LLM call
#   memory.shared: true           # new memories are shared across agents by default
#   memory.mem0.llm.provider: doubao/doubao-pro-256k
#   memory.mem0.embedder.provider: newapi/text-embedding-3-small
